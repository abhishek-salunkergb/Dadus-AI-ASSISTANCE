# ==========================================
# DADUS - Personal AI Operating Assistant
# Environment Configuration
# ==========================================

# Product Identity
PRODUCT_NAME=DADUS
ASSISTANT_NAME=Dadus
WAKE_PHRASE="Hey Dadus"
USER_TITLE=boss

# LLM Provider Configuration (OpenAI or OpenAI-compatible)
# Supports: OpenAI, Groq, Ollama, DeepSeek, Gemini (via OpenAI compatibility endpoint)
OPENAI_API_KEY=your_openai_or_groq_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# Speech-to-Text (STT) Configuration
# Providers: speech_recognition, whisper, mock
STT_PROVIDER=speech_recognition
STT_LANGUAGE=en-US

# Text-to-Speech (TTS) Configuration
# Providers: sapi (Windows Native, fast & offline), pyttsx3, openai, mock
TTS_PROVIDER=sapi
TTS_ENABLED=true
TTS_VOICE_RATE=1
TTS_VOICE_VOLUME=100

# Wake-word Engine Configuration
# Providers: keyword, mock
WAKEWORD_PROVIDER=keyword

# Security & Permissions
REQUIRE_CONFIRMATIONS=true
CONFIRMATION_TIMEOUT_SECONDS=60

# Server & UI
API_HOST=127.0.0.1
API_PORT=8000

# Logging
LOG_LEVEL=INFO
